# Supabase (Auth, Postgres, Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Schema holding LearnHub's tables ("public" on its own project, "learnhub" on the shared demo hub)
NEXT_PUBLIC_SUPABASE_DB_SCHEMA=public
# Private storage bucket for lesson videos and library files
SUPABASE_MEDIA_BUCKET=media

# Demo mode: no Stripe; choosing a plan switches it on without a card
NEXT_PUBLIC_DEMO_MODE=false

# Stripe (not needed in demo mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INSIDER=
STRIPE_PRICE_CORE=
STRIPE_PRICE_PRO=

NEXT_PUBLIC_APP_URL=http://localhost:3000
